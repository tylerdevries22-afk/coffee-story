{
  "name": "coffee-story",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~57.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.15",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.12",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "eas:login": "npx eas-cli@21.4.0 login --browser",
    "publish:preview": "npx eas-cli@21.4.0 update --channel preview --environment preview --platform ios",
    "publish:preview:android": "npx eas-cli@21.4.0 update --channel preview --environment preview --platform android",
    "publish:production": "npx eas-cli@21.4.0 update --channel production --environment production --platform ios",
    "publish:production:android": "npx eas-cli@21.4.0 update --channel production --environment production --platform android",
    "build:preview:ios": "npx eas-cli@21.4.0 build --platform ios --profile preview",
    "build:production:ios": "npx eas-cli@21.4.0 build --platform ios --profile production",
    "submit:production:ios": "npx eas-cli@21.4.0 submit --platform ios --profile production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:structure && npx expo export --platform ios",
    "test:structure": "tsx --test \"test-support/**/*.test.ts\""
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "qs": "6.15.3",
    "uuid": "11.1.1"
  },
  "private": true
}
