# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-web/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files. `.env` itself is ignored too: README tells developers to
# `cp .env.example .env`, and that file then holds real publishable keys.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
apps/*/ios/
apps/*/android/

# Coffee Story local workspace artifacts
_assets-web/
_sdk54-backup/
mobile-expo-go-demo/
logs/

# Next.js
.next/
.next-dev/
.next-preview/
next-env.d.ts

# Local package-manager cache
.pnpm-store/

# per-app metro caches
.metro-cache/
# `supabase start` local state, not project config
supabase/.branches/
supabase/.temp/
# stray bytecode from repo scripts
__pycache__/
.scratch-glass/

# Agent scratch notes. `~/Dev/.sync/dev-sync.sh` snapshots any dirty working
# tree onto the `wip/macbook` branch every 15 minutes and skips ignored paths,
# so these entries are what keeps session scratch out of both commits and that
# branch. `.claude/` itself stays tracked: launch.json, settings.json, hooks
# and skills are real project config.
**/.claude/session-notes.md
# Globbed, not root-anchored: running a command from inside packages/<pkg> or a
# worktree makes the harness write these there too, and the anchored form left
# them as untracked noise (hit in packages/domain).
**/.claude/.proven-config-version
**/.claude/proven-config.json
.claude-flow/
.swarm/
.codex/
.tmp/
apps/*/.claude/
packages/*/.claude/
apps/hq/.next-wall*/

# Ruflo Core local state (guidance bundle + vector index)
agentdb.rvf
agentdb.rvf.lock
ruvector.db
