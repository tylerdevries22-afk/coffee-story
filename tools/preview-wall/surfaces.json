{
  "$comment": "Canonical device presets and five preview surfaces. The publisher resolves activeDevice from enabled tenant capabilities; the browser has no tenant-specific logic.",
  "schemaVersion": 2,
  "devicePresets": [
    {
      "id": "desktop",
      "label": "Desktop",
      "device": "Desktop",
      "width": 1440,
      "height": 900,
      "frame": "desktop"
    },
    {
      "id": "tablet",
      "label": "Tablet",
      "device": "Tablet landscape",
      "width": 1180,
      "height": 820,
      "frame": "tablet"
    },
    {
      "id": "mobile",
      "label": "Mobile",
      "device": "Mobile portrait",
      "width": 390,
      "height": 844,
      "frame": "phone"
    }
  ],
  "surfaces": [
    {
      "launch": "display",
      "name": "Public display",
      "port": 3200,
      "path": "/board/demo",
      "span": 3,
      "devices": ["desktop", "tablet", "mobile"],
      "defaultDevice": "desktop",
      "namePreferences": [
        { "whenCapability": "construction-projects", "name": "Activity board" }
      ]
    },
    {
      "launch": "hq",
      "name": "HQ console",
      "port": 3300,
      "path": "/",
      "span": 3,
      "devices": ["desktop", "tablet", "mobile"],
      "defaultDevice": "desktop"
    },
    {
      "launch": "kiosk-web",
      "name": "Kiosk / POS",
      "port": 4180,
      "path": "/",
      "span": 2,
      "devices": ["desktop", "tablet", "mobile"],
      "defaultDevice": "tablet"
    },
    {
      "launch": "operator-web",
      "name": "Operator",
      "port": 4191,
      "path": "/",
      "span": 2,
      "devices": ["desktop", "tablet", "mobile"],
      "defaultDevice": "tablet",
      "devicePreferences": [
        { "whenCapability": "construction-projects", "device": "mobile" }
      ]
    },
    {
      "launch": "customer-web",
      "name": "Customer",
      "port": 4170,
      "path": "/",
      "span": 2,
      "devices": ["desktop", "tablet", "mobile"],
      "defaultDevice": "mobile"
    }
  ]
}
