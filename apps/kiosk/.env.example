# Public values inlined into the kiosk bundle. Never put a service-role key or
# another server secret here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The HQ deployment that serves pairing and order routes. Hosted requests are
# refused unless the URL hostname matches the explicit allowlist.
EXPO_PUBLIC_API_URL=https://your-hq-deployment.vercel.app
EXPO_PUBLIC_ALLOWED_API_HOST=your-hq-deployment.vercel.app

# Optional mobile error reporting.
EXPO_PUBLIC_SENTRY_DSN=
