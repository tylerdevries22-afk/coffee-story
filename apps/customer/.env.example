# Copy to .env and fill in. Every EXPO_PUBLIC_* value is inlined into the
# JavaScript bundle and is publicly readable, so only publishable keys belong
# here. A Supabase service-role key must never appear in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The platform API: the HQ deployment that hosts /api/orders and friends.
# These two must name the SAME host — the API client fails closed when the
# configured base and the allowlist disagree, so a mismatch breaks every
# request rather than degrading quietly. A localhost URL (local dev) needs
# no allowlist entry.
EXPO_PUBLIC_API_URL=https://your-hq-deployment.vercel.app
EXPO_PUBLIC_ALLOWED_API_HOST=your-hq-deployment.vercel.app
