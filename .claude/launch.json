{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hq",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/hq",
        "exec",
        "next",
        "dev",
        "--port",
        "3300"
      ],
      "port": 3300,
      "autoPort": false
    },
    {
      "name": "display",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/display",
        "exec",
        "next",
        "dev",
        "--port",
        "3200"
      ],
      "port": 3200,
      "autoPort": false
    },
    {
      "name": "customer-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/customer/dist-web",
        "-l",
        "4170"
      ],
      "port": 4170,
      "autoPort": false
    },
    {
      "name": "kiosk-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/kiosk/dist-web",
        "-l",
        "4180"
      ],
      "port": 4180,
      "autoPort": true
    },
    {
      "name": "operator-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/operator/dist-web",
        "-l",
        "4190"
      ],
      "port": 4190,
      "autoPort": false
    }
  ]
}
