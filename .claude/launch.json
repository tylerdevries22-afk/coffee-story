{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hq",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/hq",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3300"
      ],
      "env": {
        "COFFEE_STORY_DEMO_SYNC": "1",
        "COFFEE_STORY_PREVIEW_WALL": "1"
      },
      "port": 3300,
      "autoPort": false
    },
    {
      "name": "display",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/display",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3200"
      ],
      "env": {
        "DEMO_SYNC_URL": "http://localhost:3300/api/demo-sync",
        "PREVIEW_WALL": "1"
      },
      "port": 3200,
      "autoPort": false
    },
    {
      "name": "customer-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/customer/dist-web",
        "-l",
        "tcp://127.0.0.1:4170"
      ],
      "port": 4170,
      "autoPort": false
    },
    {
      "name": "kiosk-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/kiosk/dist-web",
        "-l",
        "tcp://127.0.0.1:4180"
      ],
      "port": 4180,
      "autoPort": false
    },
    {
      "name": "operator-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/operator/dist-web",
        "-l",
        "tcp://127.0.0.1:4191"
      ],
      "port": 4191,
      "autoPort": false
    }
  ]
}
