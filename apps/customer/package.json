    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "eas:login": "npx eas-cli@21.4.0 login --browser",
    "publish:preview": "npx eas-cli@21.4.0 update --channel preview --environment preview --platform ios",
    "publish:preview:android": "npx eas-cli@21.4.0 update --channel preview --environment preview --platform android",
    "publish:preview:all": "npx eas-cli@21.4.0 update --channel preview --environment preview --platform all",
    "publish:production": "npx eas-cli@21.4.0 update --channel production --environment production --platform ios",
    "publish:production:android": "npx eas-cli@21.4.0 update --channel production --environment production --platform android",
    "build:preview:ios": "npx eas-cli@21.4.0 build --platform ios --profile preview",
    "build:production:ios": "npx eas-cli@21.4.0 build --platform ios --profile production",
    "submit:production:ios": "npx eas-cli@21.4.0 submit --platform ios --profile production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && npx expo export --platform ios",
    "emit:menu": "tsx scripts/emit-menu.ts"
  },
  "private": true
}
