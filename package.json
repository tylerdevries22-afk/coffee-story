{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "pnpm -r --workspace-concurrency=1 lint && eslint scripts --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p scripts",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "verify": "pnpm audit:tokens && pnpm audit:brand && pnpm lint && tsc -p scripts && pnpm -r --workspace-concurrency=1 verify",
    "mutate": "tsx scripts/mutate.ts",
    "preview": "tsx scripts/preview.ts",
    "onboard": "tsx scripts/onboard.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "supabase:promote": "tsx scripts/apply-hosted-migrations.ts",
    "db:local": "tsx scripts/local-database-chain.ts",
    "supabase:verify": "supabase db lint --linked --level warning --fail-on warning && supabase db advisors --linked --type security --level warn --fail-on warn && supabase db advisors --linked --type performance --level warn --fail-on warn",
    "normalize-menu-images": "tsx scripts/normalize-menu-images.ts",
    "normalize-product-cutouts": "tsx scripts/normalize-product-cutouts.ts",
    "training:bootstrap": "tsx scripts/training-bootstrap.ts",
    "training:seed-coffee-story": "tsx scripts/seed-coffee-story-training.ts",
    "audit:tokens": "tsx scripts/audit-tokens.ts",
    "audit:brand": "tsx scripts/audit-brand-strings.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "checkly": "^8.22.0",
    "sharp": "^0.35.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vercel": "59.11.7"
  },
  "pnpm": {
    "overrides": {
      "@vercel/backends>path-to-regexp": "8.4.2",
      "@vercel/express>path-to-regexp": "8.4.2",
      "@vercel/fun>@tootallnate/once": "2.0.1",
      "@vercel/fun>path-to-regexp": "8.4.2",
      "@vercel/fun>tar": "7.5.22",
      "@vercel/hono>path-to-regexp": "8.4.2",
      "@vercel/python-analysis>js-yaml": "4.3.1",
      "@vercel/python-analysis>minimatch": "10.2.6",
      "@vercel/python-analysis>smol-toml": "1.6.1",
      "@vercel/rust>smol-toml": "1.6.1",
      "@vercel/static-config>ajv": "8.18.0",
      "decode-uri-component": "0.5.0",
      "fast-uri": ">=3.1.6",
      "metro": "0.83.8",
      "metro-config": "0.83.8",
      "metro-transform-worker": "0.83.8",
      "nanoid": "5.1.16",
      "postcss": "8.5.25",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.0",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "vercel>smol-toml": "1.6.1"
    },
    "patchedDependencies": {
      "@expo/cli@54.0.27": "patches/@expo__cli@54.0.27.patch"
    }
  },
  "dependencies": {
    "@platform/engine": "workspace:*",
    "@platform/schema": "workspace:*",
    "@platform/ui": "workspace:*",
    "@supabase/supabase-js": "^2.111.0"
  }
}
