{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hq",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/hq",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "kiosk-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-s",
        "apps/kiosk/dist",
        "-l",
        "4180"
      ],
      "port": 4180,
      "autoPort": true
    }
  ]
}
