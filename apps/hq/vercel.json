{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node \"$(git rev-parse --show-toplevel)/scripts/vercel-ignore.mjs\" hq",
  "git": {
    "deploymentEnabled": {
      "agent/**": false,
      "claude/**": false,
      "codex/**": false,
      "docs/**": false,
      "wip/**": false,
      "dependabot/**": false
    }
  },
  "crons": [
    {
      "path": "/api/jobs/run",
      "schedule": "*/5 * * * *"
    }
  ],
  "buildCommand": "cd ../.. && if [ \"${SKIP_ORG_WEB_STATICS:-}\" = \"1\" ]; then echo \"skip org web statics\"; else pnpm tsx scripts/build-org-web-statics.ts; fi && cd apps/hq && pnpm exec next build"
}
