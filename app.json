{
  "expo": {
    "name": "Coffee Story",
    "slug": "coffee-story",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coffeestory",
    "runtimeVersion": "exposdk:57.0.0",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.coffeestory.app",
      "supportsTablet": false,
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSMotionUsageDescription": "Coffee Story uses device motion so the coffee in your rewards cup responds to how you hold your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#241710",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EF",
          "image": "./assets/brand/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Coffee Story to choose a profile photo for your account."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Coffee Story to add pickup reminders to your calendar."
        }
      ],
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
