{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node \"$(git rev-parse --show-toplevel)/scripts/vercel-ignore.mjs\" hq",
  "git": {
    "deploymentEnabled": {
      "agent/**": false,
      "claude/**": false,
      "codex/**": false,
      "docs/**": false,
      "wip/**": false,
      "dependabot/**": false
    }
  },
  "crons": [
    {
      "path": "/api/jobs/run",
      "schedule": "*/5 * * * *"
    }
  ]
}
