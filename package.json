{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p scripts",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "verify": "pnpm -r --workspace-concurrency=1 verify",
    "onboard": "tsx scripts/onboard.ts",
    "normalize-menu-images": "tsx scripts/normalize-menu-images.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "checkly": "^8.22.0",
    "sharp": "^0.35.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "metro": "0.83.8",
      "metro-config": "0.83.8",
      "metro-transform-worker": "0.83.8",
      "postcss": "8.5.25",
      "uuid": "11.1.1",
      "sharp": ">=0.35.0"
    },
    "patchedDependencies": {
      "@expo/cli@54.0.27": "patches/@expo__cli@54.0.27.patch"
    }
  },
  "dependencies": {
    "@platform/engine": "workspace:*",
    "@platform/schema": "workspace:*",
    "@supabase/supabase-js": "^2.111.0",
    "@platform/ui": "workspace:*"
  }
}
