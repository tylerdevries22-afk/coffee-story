  "templates": [
    {
      "key": "guest-restroom-opening",
      "programKey": "guest-restroom",
      "routineKind": "opening",
      "revision": 1,
      "title": "Guest Restroom — Opening Inspection",
      "instructions": "Complete the approved opening inspection before the guest area opens. Report any condition that cannot be corrected during the inspection.",
      "estimatedMinutes": 15,
      "requiredRoleKeys": ["floor-operations"],
      "requiredCompetencyKeys": ["restroom-sanitation"],
      "issueCategories": ["blockage", "broken-fixture", "hazard", "supplies"],
      "steps": [
        { "key": "access-signage", "title": "Confirm access and required service signage", "responseKind": "confirm", "required": true },
        { "key": "hazards", "title": "Inspect the room for hazards", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "supplies", "title": "Verify soap, paper products, and approved supplies", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "fixtures", "title": "Clean and disinfect fixtures and high-touch surfaces", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "trash", "title": "Empty the waste bin when needed", "responseKind": "confirm", "required": true, "allowNotApplicable": true },
        { "key": "floor", "title": "Clean the floor when needed and verify it is safe", "responseKind": "pass_fail", "required": true, "issueOnFailure": true, "allowNotApplicable": true },
        { "key": "final-check", "title": "Complete the final condition check", "responseKind": "confirm", "required": true }
      ]
    },
    {
      "key": "guest-restroom-hourly",
      "programKey": "guest-restroom",
      "routineKind": "interval",
      "revision": 1,
      "title": "Guest Restroom — Hourly Clean and Check",
      "instructions": "Use the approved service signage and sanitation procedure. Record issues separately so the cleaning can be completed without hiding corrective work.",
      "estimatedMinutes": 12,
      "requiredRoleKeys": ["floor-operations"],
      "requiredCompetencyKeys": ["restroom-sanitation"],
      "issueCategories": ["blockage", "broken-fixture", "hazard", "supplies"],
      "steps": [
        { "key": "service-sign", "title": "Set the temporary service sign", "responseKind": "confirm", "required": true },
        { "key": "hazards", "title": "Inspect the room for hazards", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "supplies", "title": "Replenish soap and paper products", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "fixtures", "title": "Clean and disinfect the toilet, sink, and high-touch surfaces", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "trash", "title": "Empty the waste bin when needed", "responseKind": "confirm", "required": true, "allowNotApplicable": true },
        { "key": "floor", "title": "Spot-clean the floor when needed and verify it is safe", "responseKind": "pass_fail", "required": true, "issueOnFailure": true, "allowNotApplicable": true },
        { "key": "reopen", "title": "Complete the final check and reopen the room", "responseKind": "confirm", "required": true }
      ]
    },
    {
      "key": "guest-restroom-closing",
      "programKey": "guest-restroom",
      "routineKind": "closing",
      "revision": 1,
      "title": "Guest Restroom — Closing Deep Clean",
      "instructions": "Complete the approved closing sanitation procedure, including the required product contact time, and report unresolved conditions.",
      "estimatedMinutes": 25,
      "requiredRoleKeys": ["floor-operations"],
      "requiredCompetencyKeys": ["restroom-sanitation"],
      "issueCategories": ["blockage", "broken-fixture", "hazard", "supplies"],
      "steps": [
        { "key": "service-sign-ppe", "title": "Set service signage and use the approved PPE", "responseKind": "confirm", "required": true },
        { "key": "supplies", "title": "Replenish supplies and report low stock", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "fixtures", "title": "Clean and disinfect all fixtures and high-touch surfaces", "responseKind": "pass_fail", "required": true, "issueOnFailure": true },
        { "key": "contact-time", "title": "Observe the approved product contact time", "responseKind": "confirm", "required": true },
        { "key": "trash", "title": "Empty the waste bin", "responseKind": "confirm", "required": true },
        { "key": "floor", "title": "Sweep and clean the floor", "responseKind": "confirm", "required": true },
        { "key": "final-check", "title": "Complete the final condition check", "responseKind": "confirm", "required": true }
      ]
    }
  ],
