# Copy to .env and fill in. Every EXPO_PUBLIC_* value is inlined into the
# JavaScript bundle and is publicly readable, so only publishable keys belong
# here. A Supabase service-role key must never appear in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# These two must name the SAME host. resolvePortalUrl fails closed when the
# configured base and the allowlist disagree, so a mismatch breaks every
# outbound portal link rather than degrading quietly.
EXPO_PUBLIC_API_URL=https://coffee-story-healing-oasis.vercel.app
EXPO_PUBLIC_ALLOWED_API_HOST=coffee-story-healing-oasis.vercel.app
