{
  "expo": {
    "name": "Order Board",
    "slug": "platform-operator",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/operator-icon.png",
    "scheme": "platform-operator",
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/d7cc284c-df13-47fd-b040-75b90417019f"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.devries.platform.operator",
      "supportsTablet": true,
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.devries.platform.operator"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/operator-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF9"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7cc284c-df13-47fd-b040-75b90417019f"
      }
    },
    "owner": "tylerdevries222"
  }
}
