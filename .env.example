# ============================================================================
# Platform environment. Server-side values NEVER ship in an app bundle and
# never get an EXPO_PUBLIC_/NEXT_PUBLIC_ prefix. Every EXPO_PUBLIC_*/
# NEXT_PUBLIC_* value is inlined into a public bundle -- publishable keys only.
# The customer app's own runtime values live in apps/customer/.env.example.
# ============================================================================

# --- Supabase (database + auth) --------------------------------------------
# Server-side (engine, hq API routes, scripts). The service key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Deployment-only production database credential. The factory generates this
# at project creation, stores it in Doppler, and synchronizes it to GitHub
# Actions. Supabase cannot retrieve it later through the Management API.
SUPABASE_DB_PASSWORD=
# Direct Postgres connection string, for packages/schema/migrate.sh only.
SUPABASE_DB_URL=
# Browser-safe pair for the HQ console's session handling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The in-store order board (apps/display), one token per paired screen, issued
# from the console. NOT the anon key: board_tickets is gated on
# app.can_read_board (0033) and the anon key satisfies it for nothing -- it
# would read zero rows and the board would call that "Live". See
# apps/display/.env.example.
#
# Static and twelve hours long, so it goes dark half a day after a deploy.
# DISPLAY_DEVICE_REFRESH_SECRET is the durable replacement: the screen trades it
# for a token on demand, and it is the one to set on a new deployment.
DISPLAY_DEVICE_TOKEN=
DISPLAY_DEVICE_REFRESH_SECRET=
# Optional hosted destinations shown in HQ Apps. Values are embedded in the HQ
# bundle, so use public HTTPS URLs only; no credentials or signed device URLs.
# Local development falls back to the five-surface ports in tools/preview-wall.
NEXT_PUBLIC_CUSTOMER_URL=
NEXT_PUBLIC_OPERATOR_URL=
NEXT_PUBLIC_KIOSK_URL=
# Optional hosted five-surface wall. Leave unset to use the local wall in
# development and the tenant-safe HQ preview in production.
NEXT_PUBLIC_WALL_URL=
# Optional single-location display origin. The Pickup display tab uses this
# only with a validated selected location; never place a device token in it.
NEXT_PUBLIC_DISPLAY_URL=
# Exact comma-separated web origins permitted to send analytics. Native apps
# omit Origin and authenticate with their user/device bearer. HQ same-origin
# requests are always allowed.
ANALYTICS_ALLOWED_ORIGINS=https://customer.example.com,https://operator.example.com,https://kiosk.example.com

# --- Square (rule 3: per-location OAuth, tiered app fees) -------------------
# Application credentials from the Square developer dashboard.
# The project's JWT secret, used to MINT device tokens for the screens nobody
# signs into (kiosk, pickup display, prep station). Server-side only -- never
# EXPO_PUBLIC_. Without it, /api/devices/* answers 501 and pairing is simply
# unavailable; nothing else degrades.
#
# Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret.
# A project on asymmetric signing keys has no shared secret: keep the legacy
# HS256 secret enabled, or move signDeviceToken to the project's active key.
SUPABASE_JWT_SECRET=

SQUARE_APP_ID=
SQUARE_APP_SECRET=
# "sandbox" (default) or "production".
SQUARE_ENV=sandbox
# 32 bytes, base64 (openssl rand -base64 32): encrypts OAuth tokens at rest.
SQUARE_TOKEN_KEY=
# From the webhook subscription; the URL must match what Square calls exactly.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# scripts/square-sandbox.ts only: a sandbox seller test account.
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=

# --- Optional connector providers -----------------------------------------
# Connector authorisation runs through HQ (Integrations -> Connect): the
# credential goes to Supabase Vault (20260827192944_connector_vault_credentials)
# and the card's status comes from a connector_installations row, not from the
# environment. The catalog reports Setup required either way. They are listed
# as the names to use when one of these providers is actually wired up.
#
# Vercel is deliberately not in this block: the factory reads VERCEL_TOKEN and
# VERCEL_SCOPE further down, and a token in any other key configures nothing.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Exact public HQ origin used to register every connector callback. Required
# in production; local development derives its loopback origin from the request.
CONNECTOR_PUBLIC_ORIGIN=https://hq.example.com
# 32+ random bytes used only to sign short-lived connector state.
CONNECTOR_OAUTH_STATE_SECRET=

# --- Platform factory control plane ---------------------------------------
# These credentials create isolated industry stacks. Keep them in Doppler's
# platform-factory project; store only opaque references in Supabase tables.
# Prefer a GitHub App installation token over a personal access token.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY_OWNER=
GITHUB_TEMPLATE_OWNER=
GITHUB_TEMPLATE_REPOSITORY=
DOPPLER_SERVICE_ACCOUNT_TOKEN=
DOPPLER_WORKPLACE_SLUG=
DOPPLER_PRODUCTION_CONFIG=prd
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_ORGANIZATION_SLUG=
SUPABASE_PROJECT_REF=
VERCEL_TOKEN=
VERCEL_SCOPE=
# Optional: used by the research step. A failed research run never replaces
# the current published catalog or training release.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=
OPENAI_EVALUATION_MODEL=

# --- Notifications (engine transports) --------------------------------------
# Only what packages/engine/src/notifications.ts actually reads. Each transport
# throws naming the variables it wants, so a half-filled block fails loudly
# rather than dropping messages.
#
# SendGrid is deliberately not here. It ships in the Integrations catalog as a
# connector, authorised in HQ and stored in Supabase Vault, and the engine has
# no SendGrid transport at all -- setting SENDGRID_API_KEY here would configure
# nothing. Email through the engine means Resend.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM=

# --- Monitoring -------------------------------------------------------------
# Sentry: hq server-side; the app DSNs are EXPO_PUBLIC_SENTRY_DSN per app env.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DISPLAY_PROJECT=
SENTRY_AUTH_TOKEN=
# Checkly (npx checkly deploy) + the base URL its checks probe.
CHECKLY_API_KEY=
CHECKLY_ACCOUNT_ID=
CHECKLY_ALERT_EMAIL=
PLATFORM_BASE_URL=
DISPLAY_BASE_URL=
DISPLAY_CHECK_LOCATION_ID=
# Shared secret sent only by the synthetic deep-health check.
HEALTH_CHECK_TOKEN=

# --- Build/publish ----------------------------------------------------------
# Which applied tenant the customer and kiosk apps build for.
#
# `apps/<app>/src/tenants/` holds one directory per tenant that `pnpm onboard
# --tenant <slug> --apply` has written. This picks one, in the Expo config and
# in the bundle, from the same rule. Leave it unset while a single tenant is
# applied and it resolves to that one; once several are applied it is required,
# and both the config and the bundle throw naming the applied slugs rather than
# shipping one shop's menu under another shop's name.
#
# It must be EXPO_PUBLIC_TENANT and not the old TENANT: only EXPO_PUBLIC_* is
# inlined into the bundle, so TENANT= moved the Expo config's identity while the
# bundle kept whichever tenant was applied. A slug is not a secret, so being
# publicly readable in the bundle is fine -- put nothing else here.
EXPO_PUBLIC_TENANT=
# CI only, as a repository secret -- never in a local .env: EXPO_TOKEN
