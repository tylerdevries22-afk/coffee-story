+    const addFiles = (type, iterable) => {
+        if (!iterable) return;
+        for (const entry of iterable) {
+            const filePath = Array.isArray(entry) ? entry[0] : entry;
+            const md = Array.isArray(entry) ? entry[1] : null;
+            queue.push({
+                type,
+                filePath,
+                metadata: {
+                    type: md && md.isSymlink ? "l" : "f",
+                    modifiedTime: md ? md.modifiedTime : null
+                }
+            });
+        }
+    };
